# SparkEV System Configuration Template
# Copy to .env and adjust variables accordingly

# Environment Mode: development | production | simulation
SPARKEV_ENV=development

# REST API Settings
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
DEBUG=True

# Federated Learning (FedPer) Coordinator Settings
FEDPER_SERVER_HOST=127.0.0.1
FEDPER_SERVER_PORT=8080
FEDPER_NUM_ROUNDS=20
FEDPER_MIN_CLIENTS=5

# MQTT Telemetry Broker (In-Vehicle Edge / ESP32 Gateway)
MQTT_BROKER_HOST=localhost
MQTT_PORT=1883
MQTT_TOPIC_TELEMETRY=sparkev/vehicle/telemetry
MQTT_CLIENT_ID=sparkev-edge-01

# Vehicle Battery Physical Baseline
BATTERY_NOMINAL_KWH=60.0
BATTERY_MAX_TEMP_C=45.0
BATTERY_MIN_TEMP_C=-10.0

# External APIs
OPENCHARGEMAP_API_KEY=your_openchargemap_api_key_here
